# Copy this file to packages/server/.env (ignored by git) and put your own key in it.
# Never commit a real key.

# The provider used by default: openrouter or muse.
MODEL_PROVIDER=openrouter

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Free models only (ids end in :free), tried in this order; a busy one (429) passes to the next.
# Checked on 2026-11-22 with the draw tool: a spoken line ("a circle of radius 2, a point on it, its tangent")
# and a circled handwritten equation (read it, graph it, mark where it crosses the x-axis).
#   particle-ai/particle-1:free             text 1.4 s, picture 2.0 s, both right
#   baidu/ernie-5.5-flash-preview:free      text 1.8 s, right; reads no pictures
#   nvidia/nemotron-3.5-super-vl:free       text 2.0 s, picture 22 s, both right
#   inclusionai/ling-3.2-flash:free         picture 7.7 s, right; often busy
OPENROUTER_TEXT_MODELS=baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3.5-super-vl:free,particle-ai/particle-1:free,inclusionai/ling-3.2-flash:free

# Models for requests with a picture (circle to ask, a photo of a page).
OPENROUTER_VISION_MODELS=particle-ai/particle-1:free,nvidia/nemotron-3.5-super-vl:free,inclusionai/ling-3.2-flash:free

# Free voice models for the teacher's speech (POST /v1/speech), tried in order. Checked on 2026-11-22:
#   fish-audio/s2.1-pro-free:free        MP3, first byte 1.1 s, 3.2 s of speech in 2.8 s
#   heygen/heygen-voice-1-turbo:free     PCM only, first byte 2.1 s, needs a voice
OPENROUTER_SPEECH_MODELS=fish-audio/s2.1-pro-free:free,heygen/heygen-voice-1-turbo:free
OPENROUTER_SPEECH_VOICE=bram

# Muse Spark, the second provider.
MUSE_API_KEY=
