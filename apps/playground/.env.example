# The dev server's model keys for "Generate in chat".
# Copy this file to `.env` and fill in a key; `.env` is git-ignored.
# A key can also be pasted in the chat's Settings instead; an empty field falls back to the key here.
# Settings in the chat picks the provider: Anthropic, Meta (Muse Spark), Google Gemini or Amazon Bedrock.
ANTHROPIC_API_KEY=sk-ant-...
# A Meta Model API key (dev.meta.ai dashboard, API keys tab) for Muse Spark and Muse Wonder.
MODEL_API_KEY=
GEMINI_API_KEY=
# Live voice (Gemini Live): with this set to 1 and GEMINI_API_KEY present,
# the dev server mints short-lived Live tokens at /v1/live/token for the
# browser's voice session. Learner audio goes to Google under this
# acceptance; without it the token route stays off.
GEMINI_LIVE_RETENTION_ACCEPTED=
# A Bedrock API key (Bedrock console, API keys) and the Region its models run in.
# Bedrock here uses open-weight GLM, DeepSeek, Qwen, Kimi and MiniMax models only.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# Film narration with Cartesia: with both set, opening a film and pressing
# Narrate with Cartesia works with both fields empty; pasted values override them.
CARTESIA_API_KEY=
# A voice id from the Cartesia Voice Library (console.cartesia.ai voice library)
# or List Voices; the dev server's default when the voice field is empty.
CARTESIA_VOICE_ID=
