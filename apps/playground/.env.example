# The dev server's model keys for "Generate in chat".
# Copy this file to `.env` and fill in a key; `.env` is git-ignored.
# Settings in the chat picks the provider: Anthropic, Google Gemini or Amazon Bedrock.
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=
# A Bedrock API key (Bedrock console, API keys) and the Region its models run in.
# Bedrock here uses open-weight GLM, DeepSeek, Qwen, Kimi and MiniMax models only.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
